{
  "private": true,
  "devDependencies": {
    "@babel/cli": "^7.17.6",
    "@babel/core": "^7.17.8",
    "@babel/eslint-parser": "^7.17.0",
    "@babel/preset-env": "^7.16.11",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@wordpress/block-editor": "19.0.0",
    "@wordpress/blocks": "17.0.0",
    "@wordpress/components": "43.0.0",
    "@wordpress/element": "10.0.0",
    "@wordpress/i18n": "7.0.0",
    "@wordpress/scripts": "37.0.0",
    "babel-minify": "^0.5.2",
    "babel-plugin-transform-es2015-modules-strip": "^0.1.2",
    "babel-preset-minify": "^0.5.2",
    "concurrently": "^7.5.0",
    "eslint": "^8.12.0",
    "tslint": "^5.20.1",
    "typescript": "7.0.2",
    "wp-readme-to-markdown": "^1.0.1"
  },
  "browserslist": [
    "last 2 versions"
  ],
  "scripts": {
    "start": "npm run watch",
    "lint": "conc 'npm run lint:eslint' 'npm run lint:tslint'",
    "lint:eslint": "eslint --fix src/js/*.js; exit 0",
    "lint:tslint": "tslint 'src/angular/**/*./ts'; exit 0",
    "build": "conc 'npm run build:typeahead' 'npm run build:degree-picker' 'npm run build:blocks' 'npm run build:angular' 'npm run generate-md'",
    "build:typeahead": "babel ./src/js/ucf-degree-search.js --out-file ./static/js/ucf-degree-search.min.js",
    "build:degree-picker": "babel ./src/js/ucf-degree-picker.js --out-file ./static/js/ucf-degree-picker.min.js",
    "build:blocks": "wp-scripts build --webpack-src-dir=src/blocks --output-path=build",
    "build:angular": "cd src/angular && npm run build; exit 0",
    "watch": "conc 'npm run watch:typeahead' 'npm run watch:degree-picker' 'npm run watch:blocks' 'npm run watch:angular'",
    "watch:typeahead": "babel --watch ./src/js/ucf-degree-search.js --out-file ./static/js/ucf-degree-search.min.js",
    "watch:degree-picker": "babel --watch ./src/js/ucf-degree-picker.js --out-file ./static/js/ucf-degree-picker.min.js",
    "watch:blocks": "wp-scripts start --webpack-src-dir=src/blocks --output-path=build",
    "watch:angular": "cd src/angular && npm run watch",
    "serve:angular": "cd src/angular && npm start",
    "generate-md": "wp-readme-to-md",
    "degree-picker": "npm --prefix src/components/DegreePicker run dev",
    "typecheck:blocks": "tsc -p src/blocks/degree-picker"
  }
}
